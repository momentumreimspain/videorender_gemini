# Google Gemini (solo servidor: Vercel env o .env.local para `npm run dev`; no uses VITE_)
GEMINI_API_KEY=your_gemini_key

# Supabase Auth (momentum-auth)
# El cliente usa las VITE_*; la función serverless verifica el JWT con estas.
# Si no defines SUPABASE_URL/SUPABASE_ANON_KEY, se usan las VITE_* como fallback.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Firebase Configuration
# Get these values from Firebase Console -> Project Settings -> General
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
